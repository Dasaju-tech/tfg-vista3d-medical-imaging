+++ b/src/vista3d_tfg/data/nifti.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+import nibabel as nib
+import numpy as np
+
+
+KITS23_LABEL_NAMES: dict[int, str] = {
+    0: "background",
+    1: "kidney",
+    2: "tumor",
+    3: "cyst",
+}
+
+
+@dataclass(frozen=True, slots=True)
+class NiftiMetadata:
+    path: Path
+    shape: tuple[int, int, int]
+    spacing_mm: tuple[float, float, float]
+    orientation: tuple[str, str, str]
+    dtype: str
+    affine: tuple[tuple[float, float, float, float], ...]
+
+
+def _validate_affine(affine: np.ndarray, path: Path) -> None:
+    if affine.shape != (4, 4):
+        raise ValueError(f"Expected a 4x4 affine matrix for {path}.")
+
+    if not np.all(np.isfinite(affine)):
+        raise ValueError(f"Affine matrix contains non-finite values: {path}")
+
+    determinant = float(np.linalg.det(affine[:3, :3]))
+    if np.isclose(determinant, 0.0):
+        raise ValueError(f"Affine matrix is singular: {path}")
+
+
+def inspect_nifti(path: Path) -> NiftiMetadata:
+    path = path.resolve()
+
+    if not path.is_file():
+        raise FileNotFoundError(f"NIfTI file does not exist: {path}")
+
+    image = nib.load(str(path))
+
+    if len(image.shape) != 3:
+        raise ValueError(
+            f"Expected a 3D NIfTI volume, got shape {image.shape}: {path}"
+        )
+
+    affine = np.asarray(image.affine, dtype=float)
+    _validate_affine(affine, path)
+
+    spacing = tuple(float(value) for value in image.header.get_zooms()[:3])
+    if len(spacing) != 3 or any(
+        (not np.isfinite(value)) or value <= 0.0 for value in spacing
+    ):
+        raise ValueError(f"Invalid voxel spacing {spacing}: {path}")
+
+    orientation_codes = nib.aff2axcodes(affine)
+    orientation = tuple(
+        code if code is not None else "?" for code in orientation_codes
+    )
+
+    return NiftiMetadata(
+        path=path,
+        shape=tuple(int(value) for value in image.shape),
+        spacing_mm=spacing,
+        orientation=orientation,
+        dtype=str(image.get_data_dtype()),
+        affine=tuple(tuple(float(value) for value in row) for row in affine),
+    )
+
+
+def read_segmentation_labels(path: Path) -> tuple[int, ...]:
+    path = path.resolve()
+
+    if not path.is_file():
+        raise FileNotFoundError(f"Segmentation file does not exist: {path}")
+
+    image = nib.load(str(path))
+    data = np.asanyarray(image.dataobj)
+
+    if data.ndim != 3:
+        raise ValueError(
+            f"Expected a 3D segmentation, got shape {data.shape}: {path}"
+        )
+
+    unique_values = np.unique(data)
+
+    if not np.all(np.isfinite(unique_values)):
+        raise ValueError(f"Segmentation contains non-finite labels: {path}")
+
+    rounded = np.rint(unique_values)
+    if not np.allclose(unique_values, rounded, rtol=0.0, atol=1e-6):
+        raise ValueError(f"Segmentation contains non-integer labels: {path}")
+
+    return tuple(int(value) for value in rounded)
diff --git a/src/vista3d_tfg/data/audit.py b/src/vista3d_tfg/data/audit.py
new file mode 100644
--- /dev/null
+++ b/src/vista3d_tfg/data/audit.py
@@ -0,0 +1,141 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+from pathlib import Path
+
+import numpy as np
+
+from .kits23 import KiTS23Case
+from .nifti import KITS23_LABEL_NAMES, NiftiMetadata, inspect_nifti, read_segmentation_labels
+
+
+@dataclass(frozen=True, slots=True)
+class KiTS23CaseAudit:
+    case_id: str
+    image: NiftiMetadata
+    segmentation: NiftiMetadata
+    labels: tuple[int, ...]
+    issues: tuple[str, ...]
+
+    @property
+    def is_valid(self) -> bool:
+        return not self.issues
+
+
+@dataclass(frozen=True, slots=True)
+class KiTS23DatasetAudit:
+    cases: tuple[KiTS23CaseAudit, ...]
+
+    @property
+    def valid_cases(self) -> int:
+        return sum(case.is_valid for case in self.cases)
+
+    @property
+    def invalid_cases(self) -> int:
+        return len(self.cases) - self.valid_cases
+
+    @property
+    def is_valid(self) -> bool:
+        return self.invalid_cases == 0
+
+
+def _metadata_to_dict(metadata: NiftiMetadata) -> dict[str, object]:
+    return {
+        "path": str(metadata.path),
+        "shape": list(metadata.shape),
+        "spacing_mm": list(metadata.spacing_mm),
+        "orientation": list(metadata.orientation),
+        "dtype": metadata.dtype,
+        "affine": [list(row) for row in metadata.affine],
+    }
+
+
+def audit_case(case: KiTS23Case) -> KiTS23CaseAudit:
+    image = inspect_nifti(case.imaging_path)
+    segmentation = inspect_nifti(case.segmentation_path)
+    labels = read_segmentation_labels(case.segmentation_path)
+
+    issues: list[str] = []
+
+    if image.shape != segmentation.shape:
+        issues.append(
+            f"shape_mismatch:image={image.shape},segmentation={segmentation.shape}"
+        )
+
+    if not np.allclose(
+        np.asarray(image.affine),
+        np.asarray(segmentation.affine),
+        rtol=0.0,
+        atol=1e-5,
+    ):
+        issues.append("affine_mismatch")
+
+    if not np.allclose(
+        image.spacing_mm,
+        segmentation.spacing_mm,
+        rtol=0.0,
+        atol=1e-6,
+    ):
+        issues.append(
+            "spacing_mismatch:"
+            f"image={image.spacing_mm},segmentation={segmentation.spacing_mm}"
+        )
+
+    if image.orientation != segmentation.orientation:
+        issues.append(
+            "orientation_mismatch:"
+            f"image={image.orientation},segmentation={segmentation.orientation}"
+        )
+
+    allowed_labels = set(KITS23_LABEL_NAMES)
+    unexpected_labels = sorted(set(labels) - allowed_labels)
+    if unexpected_labels:
+        issues.append(f"unexpected_labels:{unexpected_labels}")
+
+    return KiTS23CaseAudit(
+        case_id=case.case_id,
+        image=image,
+        segmentation=segmentation,
+        labels=labels,
+        issues=tuple(issues),
+    )
+
+
+def audit_cases(cases: tuple[KiTS23Case, ...]) -> KiTS23DatasetAudit:
+    return KiTS23DatasetAudit(
+        cases=tuple(audit_case(case) for case in cases),
+    )
+
+
+def audit_to_dict(audit: KiTS23DatasetAudit) -> dict[str, object]:
+    return {
+        "schema_version": "1.0",
+        "dataset": "KiTS23",
+        "label_mapping": {
+            str(label): name for label, name in KITS23_LABEL_NAMES.items()
+        },
+        "number_of_cases": len(audit.cases),
+        "valid_cases": audit.valid_cases,
+        "invalid_cases": audit.invalid_cases,
+        "is_valid": audit.is_valid,
+        "cases": [
+            {
+                "case_id": case.case_id,
+                "is_valid": case.is_valid,
+                "labels": list(case.labels),
+                "issues": list(case.issues),
+                "image": _metadata_to_dict(case.image),
+                "segmentation": _metadata_to_dict(case.segmentation),
+            }
+            for case in audit.cases
+        ],
+    }
+
+
+def write_audit(audit: KiTS23DatasetAudit, output_path: Path) -> None:
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    output_path.write_text(
+        json.dumps(audit_to_dict(audit), indent=2, sort_keys=True),
+        encoding="utf-8",
+    )
diff --git a/tests/test_nifti_audit.py b/tests/test_nifti_audit.py
new file mode 100644
--- /dev/null
+++ b/tests/test_nifti_audit.py
@@ -0,0 +1,160 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+import nibabel as nib
+import numpy as np
+import pytest
+
+from vista3d_tfg.data.audit import audit_case, audit_cases, audit_to_dict, write_audit
+from vista3d_tfg.data.kits23 import discover_case
+from vista3d_tfg.data.nifti import inspect_nifti, read_segmentation_labels
+
+
+def _write_nifti(path: Path, data: np.ndarray, affine: np.ndarray) -> None:
+    nib.save(nib.Nifti1Image(data, affine), str(path))
+
+
+def _create_case(
+    root: Path,
+    *,
+    case_name: str = "case_00001",
+    image_shape: tuple[int, int, int] = (8, 9, 10),
+    segmentation_shape: tuple[int, int, int] | None = None,
+    image_affine: np.ndarray | None = None,
+    segmentation_affine: np.ndarray | None = None,
+    labels: tuple[int, ...] = (0, 1, 2, 3),
+) -> Path:
+    directory = root / case_name
+    directory.mkdir()
+
+    segmentation_shape = segmentation_shape or image_shape
+    image_affine = image_affine if image_affine is not None else np.diag([1.0, 2.0, 3.0, 1.0])
+    segmentation_affine = (
+        segmentation_affine if segmentation_affine is not None else image_affine
+    )
+
+    image = np.zeros(image_shape, dtype=np.float32)
+    segmentation = np.zeros(segmentation_shape, dtype=np.uint8)
+
+    flat = segmentation.reshape(-1)
+    for index, label in enumerate(labels):
+        if index < flat.size:
+            flat[index] = label
+
+    _write_nifti(directory / "imaging.nii.gz", image, image_affine)
+    _write_nifti(
+        directory / "segmentation.nii.gz",
+        segmentation,
+        segmentation_affine,
+    )
+
+    return directory
+
+
+def test_inspect_nifti_reads_geometry(tmp_path: Path) -> None:
+    directory = _create_case(tmp_path)
+
+    metadata = inspect_nifti(directory / "imaging.nii.gz")
+
+    assert metadata.shape == (8, 9, 10)
+    assert metadata.spacing_mm == pytest.approx((1.0, 2.0, 3.0))
+    assert metadata.orientation == ("R", "A", "S")
+    assert metadata.dtype == "float32"
+
+
+def test_read_segmentation_labels(tmp_path: Path) -> None:
+    directory = _create_case(tmp_path)
+
+    assert read_segmentation_labels(directory / "segmentation.nii.gz") == (0, 1, 2, 3)
+
+
+def test_valid_kits23_case_passes_audit(tmp_path: Path) -> None:
+    directory = _create_case(tmp_path)
+    case = discover_case(directory)
+
+    result = audit_case(case)
+
+    assert result.is_valid
+    assert result.issues == ()
+    assert result.labels == (0, 1, 2, 3)
+
+
+def test_shape_mismatch_is_reported(tmp_path: Path) -> None:
+    directory = _create_case(
+        tmp_path,
+        segmentation_shape=(8, 9, 9),
+    )
+
+    result = audit_case(discover_case(directory))
+
+    assert not result.is_valid
+    assert any(issue.startswith("shape_mismatch:") for issue in result.issues)
+
+
+def test_affine_mismatch_is_reported(tmp_path: Path) -> None:
+    image_affine = np.diag([1.0, 2.0, 3.0, 1.0])
+    segmentation_affine = np.diag([1.5, 2.0, 3.0, 1.0])
+
+    directory = _create_case(
+        tmp_path,
+        image_affine=image_affine,
+        segmentation_affine=segmentation_affine,
+    )
+
+    result = audit_case(discover_case(directory))
+
+    assert not result.is_valid
+    assert "affine_mismatch" in result.issues
+    assert any(issue.startswith("spacing_mismatch:") for issue in result.issues)
+
+
+def test_unexpected_label_is_reported(tmp_path: Path) -> None:
+    directory = _create_case(tmp_path, labels=(0, 1, 4))
+
+    result = audit_case(discover_case(directory))
+
+    assert not result.is_valid
+    assert "unexpected_labels:[4]" in result.issues
+
+
+def test_non_integer_segmentation_label_is_rejected(tmp_path: Path) -> None:
+    directory = tmp_path / "case_00001"
+    directory.mkdir()
+    affine = np.eye(4)
+
+    _write_nifti(
+        directory / "imaging.nii.gz",
+        np.zeros((3, 3, 3), dtype=np.float32),
+        affine,
+    )
+
+    segmentation = np.zeros((3, 3, 3), dtype=np.float32)
+    segmentation[0, 0, 0] = 1.5
+    _write_nifti(directory / "segmentation.nii.gz", segmentation, affine)
+
+    with pytest.raises(ValueError, match="non-integer"):
+        audit_case(discover_case(directory))
+
+
+def test_dataset_audit_serializes_to_json(tmp_path: Path) -> None:
+    first = discover_case(_create_case(tmp_path, case_name="case_00001"))
+    second = discover_case(
+        _create_case(tmp_path, case_name="case_00002", labels=(0, 1, 4))
+    )
+
+    audit = audit_cases((first, second))
+    payload = audit_to_dict(audit)
+
+    assert audit.valid_cases == 1
+    assert audit.invalid_cases == 1
+    assert not audit.is_valid
+    assert payload["number_of_cases"] == 2
+    assert payload["label_mapping"]["2"] == "tumor"
+
+    output_path = tmp_path / "outputs" / "audit.json"
+    write_audit(audit, output_path)
+
+    text = output_path.read_text(encoding="utf-8")
+    assert '"dataset": "KiTS23"' in text
+    assert '"invalid_cases": 1' in text
diff --git a/tests/test_config.py b/tests/test_config.py
new file mode 100644
--- /dev/null
+++ b/tests/test_config.py
@@ -0,0 +1,32 @@
+from pathlib import Path
+
+import pytest
+
+from vista3d_tfg.config import ProjectPaths, discover_project_root
+
+
+def test_project_paths_are_derived_from_root(tmp_path: Path) -> None:
+    paths = ProjectPaths(tmp_path)
+
+    assert paths.data == tmp_path / "data"
+    assert paths.raw == tmp_path / "data" / "raw"
+    assert paths.processed == tmp_path / "data" / "processed"
+    assert paths.outputs == tmp_path / "outputs"
+    assert paths.manifests == tmp_path / "outputs" / "manifests"
+
+
+def test_discover_project_root_from_nested_directory(tmp_path: Path) -> None:
+    project_root = tmp_path / "project"
+    nested = project_root / "src" / "package"
+    nested.mkdir(parents=True)
+    (project_root / "pyproject.toml").write_text("[project]\nname='demo'\n")
+
+    assert discover_project_root(nested) == project_root.resolve()
+
+
+def test_discover_project_root_raises_without_marker(tmp_path: Path) -> None:
+    isolated = tmp_path / "isolated"
+    isolated.mkdir()
+
+    with pytest.raises(RuntimeError, match="Could not locate the project root"):
+        discover_project_root(isolated)
diff --git a/tests/test_manifest.py b/tests/test_manifest.py
new file mode 100644
--- /dev/null
+++ b/tests/test_manifest.py
@@ -0,0 +1,50 @@
+import json
+from pathlib import Path
+
+from vista3d_tfg.data.kits23 import KiTS23Case
+from vista3d_tfg.data.manifest import build_manifest, case_to_record, write_manifest
+
+
+def _case(root: Path, case_id: str, number: int, with_instances: bool) -> KiTS23Case:
+    directory = root / case_id
+    instances = directory / "instances" if with_instances else None
+
+    return KiTS23Case(
+        case_id=case_id,
+        case_number=number,
+        directory=directory,
+        imaging_path=directory / "imaging.nii.gz",
+        segmentation_path=directory / "segmentation.nii.gz",
+        instances_path=instances,
+    )
+
+
+def test_case_to_record(tmp_path: Path) -> None:
+    case = _case(tmp_path, "case_00007", 7, True)
+
+    record = case_to_record(case)
+
+    assert record["case_id"] == "case_00007"
+    assert record["case_number"] == 7
+    assert record["has_instances"] is True
+    assert record["instances_path"].endswith("instances")
+
+
+def test_manifest_build_and_write(tmp_path: Path) -> None:
+    cases = (
+        _case(tmp_path, "case_00001", 1, False),
+        _case(tmp_path, "case_00002", 2, True),
+    )
+
+    manifest = build_manifest(cases)
+
+    assert manifest["dataset"] == "KiTS23"
+    assert manifest["number_of_cases"] == 2
+    assert manifest["cases"][0]["instances_path"] is None
+
+    output_path = tmp_path / "nested" / "manifest.json"
+    write_manifest(manifest, output_path)
+
+    loaded = json.loads(output_path.read_text(encoding="utf-8"))
+    assert loaded["schema_version"] == "1.0"
+    assert loaded["number_of_cases"] == 2
